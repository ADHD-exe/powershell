.history/
.vscode/
*.log
*.tmp
*.cache
.DS_Store
Thumbs.db

# Backups written by bootstrap.ps1 / deploy-configs.ps1 before they overwrite
*.bak
*.bak-*

# Installed PowerShell modules and scripts (provisioned by the profile and the
# bootstrap at setup time, not committed)
Modules/
Scripts/

# PowerShell's updatable-help cache
Help/

# Machine-specific package snapshots / UniGetUI exports
bootstrap-packages/wingit-list.txt
bootstrap-packages/pwshpack.ps1
winget-apps.txt

# Per-machine state that the vendored app configs must not carry
settings/notepad++/session.xml
settings/notepad++/*.bak
settings/everything/Run History.csv
settings/opencode/node_modules/
settings/opencode/package-lock.json
settings/atuin/key
settings/atuin/session
settings/atuin/*.db
